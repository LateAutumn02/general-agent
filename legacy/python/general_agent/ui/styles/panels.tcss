/* ===================================================================
   panels.tcss — Message / tool / error panel styles

   CSS-class driven.  Renderers attach classes via PanelMeta;
   the classes below supply visual appearance without Rich Panel()
   wrappers, keeping Rich text selectable.
   ================================================================== */

/* -- Base chat message ------------------------------------------ */
.chat-message {
    width: 1fr;
}

/* -- User message block ----------------------------------------- */
.user-message {
    margin: 0;
    padding: 0 0 0 1;
    background: black;
    border: none;
}

/* -- Expand variant --------------------------------------------- */
.expand {
    width: 1fr;
}

/* -- Shared panel base ------------------------------------------ */
.agent-response,
.info-message,
.tool-panel,
.error-panel,
.system-notice {
    background: black;
    padding: 0 1;
    margin: 0;
    border: none;
}

/* -- Agent response --------------------------------------------- */
.agent-response {
    background: black;
}

/* -- Info / dim ------------------------------------------------- */
.info-message {
    background: black;
}

/* -- System notice / warning ------------------------------------ */
.system-notice {
    background: black;
}

/* -- Tool panels ------------------------------------------------ */
.tool-panel {
    background: black;
}
.tool-panel.completed {
    background: black;
}
.tool-panel.failed {
    background: black;
}
.tool-panel.running {
    background: black;
}

/* -- Error panels ----------------------------------------------- */
.error-panel {
    background: black;
}

.transcript-message {
    width: 1fr;
}

.chat-separator {
    width: 1fr;
    background: black;
    color: $text-muted;
    padding: 0 1;
    margin: 0;
    border: none;
}
