/* ===================================================================
   layout.tcss — general-agent Textual UI layout

   Three-zone layout:
      StatusBar    (height 1, docked top)
      Chat / streaming area (1fr, inside viewport container)
      PromptInput  (height 3, docked bottom)
   ================================================================== */

Screen {
    scrollbar-color: $scrollbar;
    scrollbar-background: black;
    background: black;
}

/* -- StatusBar -------------------------------------------------- */
StatusBar {
    width: 100%;
    height: 1;
    background: $background;
    padding: 0 1;
}

/* -- Viewport (main content area) ------------------------------- */
#viewport {
    height: 1fr;
    background: black;
}

/* -- ChatContainer ---------------------------------------------- */
ChatContainer {
    height: 1fr;
    padding: 0 0;
    scrollbar-gutter: stable;
    background: black;
}

/* -- Loading indicator ------------------------------------------ */
LoadingIndicator {
    height: 1;
    display: none;
}
LoadingIndicator.active {
    display: block;
}

/* -- Streaming output ------------------------------------------- */
#streaming-output {
    height: auto;
    max-height: 50%;
    display: none;
    background: black;
    padding: 0 1;
    overflow-y: auto;
    scrollbar-gutter: stable;
}
#streaming-output.active {
    display: block;
}

/* -- PromptInput ------------------------------------------------ */
PromptInput {
    height: 1;
    background: #343536;
    color: #807B6E;
    border: none;
    padding: 0 1;
}

PromptInput:focus-within {
    border: none;
}

PromptInput.bash-mode {
    outline: none;
}

#permission-panel {
    height: auto;
    display: none;
    background: #343536;
    color: #807B6E;
    padding: 1 2;
}

#permission-text {
    background: #343536;
    color: #807B6E;
}

#permission-options {
    height: auto;
    max-height: 5;
    background: #343536;
    color: #807B6E;
}

#permission-reason-inline {
    height: 1;
    display: none;
    background: #343536;
    color: #807B6E;
    border: none;
    padding: 0 1;
}

#session-footer {
    height: 1;
    background: #343536;
    padding: 0 1;
}

/* -- Background task board -------------------------------------- */
#task-board-header {
    height: auto;
    padding: 1 2 0 2;
    background: black;
}

#task-board-list {
    height: 1fr;
    padding: 0 2;
    background: $surface;
}

#task-board-footer {
    height: auto;
    padding: 0 2 1 2;
    background: $surface;
    color: $text-muted;
}

#task-detail {
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#task-loading {
    height: 1;
    display: none;
}

#task-loading.active {
    display: block;
}

#task-streaming-output {
    height: auto;
    max-height: 35%;
    display: none;
    background: $surface;
    padding: 0 1;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

#task-streaming-output.active {
    display: block;
}
